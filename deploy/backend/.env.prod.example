# Copy this file to backend/env/.env.prod on the server and replace every placeholder.
# Do not commit the resulting .env.prod file.

APP_ENV=prod
ENVIRONMENT=prod
TIMEZONE=Asia/Shanghai

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-a-strong-db-password
DATABASE_NAME=fa_fi_pgdb

POSTGRES_DB=fa_fi_pgdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-db-password

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
APP_NAME=FI系统
LOGGER_LEVEL=INFO

POOL_SIZE=3
MAX_OVERFLOW=2
POOL_TIMEOUT=30
POOL_RECYCLE=1800
POOL_PRE_PING=true
POOL_USE_LIFO=true
DATABASE_ECHO=false

REDIS_ENABLE=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_NAME=1
REDIS_USER=
REDIS_PASSWORD=replace-with-a-strong-redis-password

CORS_ORIGIN_ENABLE=true
ALLOW_ORIGINS=["https://chyichyi.com","https://www.chyichyi.com"]
ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
ALLOW_HEADERS=["*"]
ALLOW_CREDENTIALS=true

HSTS_ENABLE=true
IP_LOCATION_ENABLE=false
OAUTH_FRONTEND_FALLBACK=https://www.chyichyi.com/login
OAUTH_FEISHU_APP_ID=
OAUTH_FEISHU_APP_SECRET=
OAUTH_WECHAT_OPEN_APP_ID=
OAUTH_WECHAT_OPEN_APP_SECRET=
